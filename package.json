{
  "name": "yaodi-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "姚迪 · UI/UX 设计师作品集 — 前后端分离，Cloudflare Workers + KV",
  "scripts": {
    "dev": "node scripts/build.mjs && wrangler dev",
    "build": "tsc -p frontend/tsconfig.json --noEmit && node scripts/build.mjs",
    "check": "tsc -p frontend/tsconfig.json --noEmit",
    "cf:dev": "node scripts/build.mjs && wrangler dev",
    "cf:deploy": "tsc -p frontend/tsconfig.json --noEmit && node scripts/build.mjs && wrangler deploy",
    "package:pages": "node scripts/build.mjs && node scripts/package-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
